{
  "name": "lssd-rms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Los Santos Sheriff's Department — Records Management System",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "node scripts/smoke.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -r https://github.com/TheBllazer/LSSD.git -m \"Deploiement LSSD RMS\"",
    "rules:deploy": "npx --yes firebase-tools deploy --only firestore:rules,firestore:indexes",
    "emulators": "npx --yes firebase-tools emulators:start --only firestore,auth"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.4",
