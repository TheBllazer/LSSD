# ==========================================================================
#  LSSD RMS — Variables d'environnement
#  Copier ce fichier en `.env.local` et renseigner les valeurs.
#  `.env.local` est ignoré par Git : les clés ne partent jamais sur le dépôt.
#
#  Rappel : les clés Firebase d'une application web sont PUBLIQUES par
#  conception (elles finissent dans le bundle). Elles n'autorisent rien à
#  elles seules — la sécurité repose sur les règles Firestore et App Check.
# ==========================================================================

# --- Firebase (Console > Paramètres du projet > Vos applications > Web) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- App Check (facultatif, recommandé en production) ---
# Console > App Check > reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=

# --- Déploiement ---
# Chemin de base du site. GitHub Pages sur un dépôt nommé "LSSD" => /LSSD/
# Domaine personnalisé ou dépôt <user>.github.io => /
VITE_BASE_PATH=/LSSD/

# --- Divers ---
VITE_APP_NAME=LSSD RMS
VITE_APP_VERSION=1.0.0
# Nom de l'agence affiché dans l'UI et les PDF
VITE_AGENCY_NAME=Los Santos Sheriff's Department

# --- Développement local ---
# Mettre à 1 pour brancher l'application sur les émulateurs Firebase
VITE_USE_EMULATORS=0
